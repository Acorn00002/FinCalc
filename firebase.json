{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**"
    ],
    "rewrites": [
      { "source": "/api/news", "function": "newsProxy" },
      { "source": "/api/ask-ai", "function": "aiAsk" },
      { "source": "/api/sync-calendar", "function": "syncFinancialCalendarManual" },
      { "source": "/api/send-push", "function": "sendPushNotification" },
      { "source": "/api/upsert-calendar-event", "function": "upsertCalendarEvent" },
      { "source": "/api/delete-calendar-event", "function": "deleteCalendarEvent" }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "emulators": {
    "hosting": { "port": 5000 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
