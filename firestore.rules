rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 마이페이지 포인트/히스토리 — 본인 것만 읽고 쓸 수 있어야 함
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // 캘린더 일정 알림(🔔) 구독 — 본인이 직접 켜고 끄는 서브컬렉션이라 관리자 비밀값 없이 본인만 허용.
      // dispatchEventReminders(Admin SDK)가 collectionGroup으로 전체를 훑어 D-1/D-Day 발송에 사용한다.
      match /eventReminders/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 개인 일정(비공개) — 본인만 보고 쓸 수 있는 캘린더 메모/일정
      match /personalEvents/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 마이페이지 "내 자산 현황 및 동향" 대시보드 — 현금/주식/부동산 입력값과 자산 목표(goalAmount/goalDate)를
    // 본인 uid 문서(userAssets/{uid})에만 저장한다. read/write 모두 본인 인증을 요구하는 것과 별개로,
    // create/update는 필드명(hasOnly)과 타입·음수 여부까지 서버에서 재검증해 클라이언트가 조작한 임의
    // 필드나 음수 값이 저장되지 않게 방어한다. goalAmount/goalDate는 목표를 아직 설정 안 한 사용자도
    // 있어 선택 필드로 두되, 존재할 때는 타입을 검증한다. delete는 request.resource가 없어(문서 자체가
    // 사라지는 연산) 별도 규칙으로 분리했다.
    match /userAssets/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['cash', 'stock', 'realestate', 'updatedAt', 'goalAmount', 'goalDate'])
        && request.resource.data.cash is number && request.resource.data.cash >= 0
        && request.resource.data.stock is number && request.resource.data.stock >= 0
        && request.resource.data.realestate is number && request.resource.data.realestate >= 0
        && (!('goalAmount' in request.resource.data) || (request.resource.data.goalAmount is number && request.resource.data.goalAmount >= 0))
        && (!('goalDate' in request.resource.data) || request.resource.data.goalDate is string);
      allow delete: if request.auth != null && request.auth.uid == userId;

      // 월별 자산 변화 기록(SAVE 스타일) — 문서 ID를 반드시 "YYYY-MM" 형태로 강제해 임의 서브컬렉션
      // 문서가 끼어들지 못하게 하고, total/cash/stock/realestate도 위 본문서와 동일하게 음수/타입을 검증한다.
      match /history/{monthId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && monthId.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['total', 'cash', 'stock', 'realestate', 'recordedAt'])
          && request.resource.data.total is number && request.resource.data.total >= 0
          && request.resource.data.cash is number && request.resource.data.cash >= 0
          && request.resource.data.stock is number && request.resource.data.stock >= 0
          && request.resource.data.realestate is number && request.resource.data.realestate >= 0;
      }
    }

    // 도배/매크로 방지 — users/{uid}.lastActivityAt을 기준으로 60초 이내 연속 작성을 막는다.
    // 최초 작성(필드 없음)은 항상 허용. 클라이언트가 성공 직후 이 필드를 갱신한다(markLoungeActivity).
    function loungeNotRateLimited() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || !('lastActivityAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        || request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastActivityAt + duration.value(60, 's');
    }

    // 자산 라운지 게시글 — 로그인 없이도 피드는 보이게(공개), 작성은 로그인 + 본인 uid + 쿨타임 통과 시에만.
    // update는 다른 로그인 사용자도 필요하지만(좋아요/투표/신고/댓글수), title·content·uid 등 본문 필드까지
    // 아무나 고칠 수 있으면 안 되므로 실제로 클라이언트가 쓰는 필드만 정확히 열어준다:
    // likedUsers/likesCount(toggleLike), poll(submitVote — poll.options/poll.votedUserIds는 affectedKeys()에서
    // 최상위 키 'poll' 하나로 잡힘), reportCount/reportedBy/blinded(신고), commentsCount(댓글 작성자가 증가시킴).
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && loungeNotRateLimited();
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['likedUsers', 'likesCount', 'poll', 'reportCount', 'reportedBy', 'blinded', 'commentsCount']
        );
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 댓글 — 게시글과 동일한 쿨타임을 공유한다(글+댓글 합쳐서 60초에 1번).
    // update는 원래 전면 금지였는데, 신고 카운트/블라인드 처리를 위해 딱 그 3개 필드만 열어준다 —
    // 댓글 내용(content)이나 작성자 정보는 여전히 아무도(작성자 포함) 수정할 수 없다.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && loungeNotRateLimited();
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount', 'reportedBy', 'blinded']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 금융 캘린더 — DART/청약홈 자동 수집 파이프라인(Cloud Functions, Admin SDK)만 쓸 수 있고
    // 클라이언트는 읽기만 가능. Admin SDK는 이 규칙을 우회하므로 write는 항상 false로 막아둔다.
    match /calendarEvents/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // 정부지원금(보조금24) 실데이터 — Cloud Function(syncGov24Subsidies, Admin SDK)만 쓸 수 있고
    // 클라이언트는 읽기만 가능.
    match /supportPrograms/{programId} {
      allow read: if true;
      allow write: if false;
    }

    // 청약·공모주 캐시 — DART 상세 조회가 느려서(신고서 건수만큼 병렬 호출) 스케줄 함수
    // (syncIpoScheduleCache, Admin SDK)가 20분마다 미리 갱신해두는 캐시. 클라이언트는 읽기만 가능.
    match /ipoScheduleCache/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 알림함 — 관리자 발송 Cloud Function(Admin SDK, 비밀키로 보호됨)만 쓸 수 있고 클라이언트는 읽기만 가능.
    // 읽음/삭제 상태는 전역 알림 문서가 아니라 기기(localStorage)에 개인화해서 저장한다.
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if false;
    }

    // FCM 푸시 토큰 — 로그인 여부와 무관하게 알림 수신에 동의만 하면 등록되므로 읽기/로그인 요구 없이
    // 문서 생성/갱신만 허용한다. 실제 발송(Admin SDK)과 토큰 조회는 서버 쪽 Cloud Function에서만 이뤄진다.
    match /fcmTokens/{tokenId} {
      allow read: if false;
      allow create, update: if request.resource.data.token is string;
      allow delete: if false;
    }

    // 세무사 1:1 절세 상담(베타 신청) 리드 — 연락처 등 개인정보라 로그인한 본인만 남길 수 있고,
    // 쓰기 전용(read: false)이라 다른 사용자는 물론 작성자 본인도 클라이언트에서 다시 읽을 수 없다.
    // 실제 상담 연결 인프라가 아직 없어 신청 접수만 하는 단계라, 수정/삭제도 막아둔다.
    match /taxConsultLeads/{leadId} {
      allow read: if false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
